# Tidal: sea glass and surf. Pale green-blue, very rounded, relaxed;
# clips are smooth white pebbles with a single-line waveform and a teal
# accent that never shouts.
# The light colours are from the mock-ups (the accent and dim text are
# a little darker, to pass the contrast check); the dark ones are
# derived.

name = Tidal
about = Pale sea glass, soft rounded shapes and single-line waveforms.
designed = light

[shape]
radius = 12
clip_radius = 12
line = 1
gap = 9 4
padding = 8 3
shadow = 6
loop = filled

[type]
body = 14
small = 11.5
heading = 19
numerals = 18
font = nunito
numerals_font = nunito

[waveform]
style = line
weight = 1.5

[texture]
kind = none

[glow]
on = no
radius = 0

[light]
bg = #e6f1ef
panel = #f2f8f7
lane = #eef5f3
raised = #ffffff
line = #c6dcd8
grid = #c6dcd8
grid_fine = #dfeae7
text = #1f3a37
text_dim = #4a6b67
accent = #1a7a6c
on_accent = #ffffff
selection = #bfe3dc
record = #d0503a
playhead = #1f3a37
glow = #00000000
loop = #1f8a7a29
marker = #1a7a6c
comment = #b8508a
tempo = #436d27
signature = #3d6fa3
clip_fill = #ffffff
clip_border = #c6dcd8
clip_text = #1f3a37
clip_label = none
meter_bg = #dbe9e6
meter_low = #3f7f5a
meter_mid = #1a7a6c
meter_high = #c2402a
good = #2f7d4f
warn = #7a5200
error = #b8321e
texture = #00000000
shadow = #1f3a3720
tracks = #1a7a6c #b8508a #4f7f2e #a06a1f #5a60b8 #22789e #b8583a #7a6c1f

[dark]
