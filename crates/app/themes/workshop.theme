# Workshop: a calm workbench. Warm matte greys and copper, rounder
# corners, and depth from layered panels with soft shadows instead of
# glow. Clip names sit on small paper labels.
# The dark colours are from the mock-ups; the light ones are derived.

name = Workshop
about = Warm matte greys and copper, with soft shadows and paper clip labels.
designed = dark

[shape]
radius = 8
clip_radius = 7
line = 1
gap = 8 4
padding = 6 2
shadow = 10
loop = filled

[type]
body = 13.5
small = 11
heading = 18
numerals = 17
numerals_face = mono

[waveform]
style = filled
weight = 1

[texture]
kind = none

[glow]
on = yes
radius = 4

