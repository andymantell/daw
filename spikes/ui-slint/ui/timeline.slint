// SPDX-License-Identifier: GPL-3.0-or-later
// Spike 0.1 C, second candidate toolkit (Slint). The window is declared
// here; spikes/ui-slint/src/main.rs works out what is visible and feeds it
// in. Clips are real elements (so a screen reader can find each one), and
// each clip's waveform is an image drawn in Rust.

import { Button, LineEdit, VerticalBox, HorizontalBox } from "std-widgets.slint";

export struct ClipView {
    x: length,
    y: length,
    w: length,
    h: length,
    name: string,
    color: color,
    selected: bool,
    wave: image,
    wave-x: length,
    wave-w: length,
}

export struct TrackView {
    y: length,
    name: string,
}

export struct Tick {
    x: length,
    label: string,
}

export component MainWindow inherits Window {
    title: "Timeline UI spike (Slint)";
    preferred-width: 1280px;
    preferred-height: 800px;
    background: #1b1b1b;

    in property <[ClipView]> clips;
    in property <[TrackView]> tracks;
    in property <[Tick]> ticks;
    in property <length> playhead-x;
    in property <length> track-height;
    in property <string> time-text;
    in property <string> stats;
    in property <string> summary;
    in property <bool> playing;
    in property <bool> has-selection;
    in property <bool> renaming;
    in property <string> rename-text;
    in-out property <bool> show-stats: true;
    out property <length> area-width: area.width;
    out property <length> area-height: area.height;

    callback quit();
    callback toggle-play();
    callback rename();
    callback delete();
    callback zoom(float);
    callback scrolled(length, length, bool, length);
    callback press(length, length);
    callback drag(length, length);
    callback release();
    callback double-click(length, length);
    callback rename-done(string);
    callback rename-cancel();

    MenuBar {
        Menu {
            title: "File";
            MenuItem {
                title: "Quit";
                activated => { root.quit(); }
            }
        }
        Menu {
            title: "Edit";
            MenuItem {
                title: "Rename clip (F2)";
                enabled: root.has-selection;
                activated => { root.rename(); }
            }
            MenuItem {
                title: "Delete clip (Del)";
                enabled: root.has-selection;
                activated => { root.delete(); }
            }
        }
        Menu {
            title: "View";
            MenuItem {
                title: "Zoom in (+)";
                activated => { root.zoom(1.25); }
            }
            MenuItem {
                title: "Zoom out (-)";
                activated => { root.zoom(0.8); }
            }
            MenuItem {
                title: root.show-stats ? "Hide frame statistics" : "Show frame statistics";
                activated => { root.show-stats = !root.show-stats; }
            }
        }
    }

    keys := FocusScope {
        key-pressed(event) => {
            if (event.text == " ") {
                root.toggle-play();
                return accept;
            }
            if (event.text == Key.F2) {
                root.rename();
                return accept;
            }
            if (event.text == Key.Delete) {
                root.delete();
                return accept;
            }
            if (event.text == "+" || event.text == "=") {
                root.zoom(1.25);
                return accept;
            }
            if (event.text == "-") {
                root.zoom(0.8);
                return accept;
            }
            reject
        }

        VerticalLayout {
            HorizontalLayout {
                padding: 4px;
                spacing: 8px;
                height: 36px;
                Button {
                    text: root.playing ? "Stop" : "Play";
                    clicked => {
                        root.toggle-play();
                        keys.focus();
                    }
                }

                Text {
                    text: root.time-text;
                    vertical-alignment: center;
                    color: #cccccc;
                }

                Rectangle { }
            }

            HorizontalLayout {
                // Track headers.
                Rectangle {
                    width: 150px;
                    background: #141414;
                    Rectangle {
                        y: 24px;
                        height: parent.height - 24px;
                        clip: true;
                        for t in root.tracks: Rectangle {
                            x: 1px;
                            y: t.y + 1px;
                            width: parent.width - 2px;
                            height: root.track-height - 2px;
                            background: #3c3c3c;
                            border-radius: 2px;
                            accessible-role: text;
                            accessible-label: t.name;
                            Text {
                                x: 8px;
                                height: parent.height;
                                vertical-alignment: center;
                                text: t.name;
                                color: #cccccc;
                            }
                        }
                    }
                }

                VerticalLayout {
                    // Ruler.
                    Rectangle {
                        height: 24px;
                        background: #262626;
                        clip: true;
                        for tick in root.ticks: Rectangle {
                            x: tick.x;
                            y: 12px;
                            width: 1px;
                            height: 12px;
                            background: #8c8c8c;
                        }
                        for tick in root.ticks: Text {
                            x: tick.x + 3px;
                            y: 2px;
                            text: tick.label;
                            font-size: 11px;
                            color: #cccccc;
                        }
                    }

                    area := Rectangle {
                        background: #0a0a0a;
                        clip: true;
                        accessible-role: list;
                        accessible-label: root.summary;
                        for t in root.tracks: Rectangle {
                            y: t.y + root.track-height - 1px;
                            height: 1px;
                            background: #262626;
                        }
                        for c in root.clips: Rectangle {
                            x: c.x;
                            y: c.y;
                            width: c.w;
                            height: c.h;
                            background: c.color.darker(0.45);
                            border-radius: 3px;
                            border-width: c.selected ? 2px : 1px;
                            border-color: c.selected ? white : c.color;
                            clip: true;
                            accessible-role: list-item;
                            accessible-label: c.name;
                            accessible-item-selected: c.selected;
                            Image {
                                x: c.wave-x;
                                y: 20px;
                                width: c.wave-w;
                                height: c.h - 24px;
                                source: c.wave;
                                image-fit: fill;
                            }
                            if c.w > 40px: Text {
                                x: 4px;
                                y: 2px;
                                text: c.name;
                                color: white;
                                font-size: 12px;
                            }
                        }
                        Rectangle {
                            x: root.playhead-x - 1px;
                            width: 2px;
                            background: #ff503c;
                        }

                        TouchArea {
                            scroll-event(event) => {
                                root.scrolled(event.delta-x, event.delta-y, event.modifiers.control, self.mouse-x);
                                accept
                            }
                            pointer-event(event) => {
                                if (event.kind == PointerEventKind.down && event.button == PointerEventButton.left) {
                                    keys.focus();
                                    root.press(self.mouse-x, self.mouse-y);
                                }
                                if (event.kind == PointerEventKind.up) {
                                    root.release();
                                }
                            }
                            moved => {
                                if (self.pressed) {
                                    root.drag(self.mouse-x, self.mouse-y);
                                }
                            }
                            double-clicked => {
                                root.double-click(self.mouse-x, self.mouse-y);
                            }
                        }
                    }
                }
            }

            if root.show-stats: Text {
                height: 20px;
                x: 8px;
                text: root.stats;
                color: #cccccc;
                font-size: 12px;
                vertical-alignment: center;
            }
        }
    }

    if root.renaming: FocusScope {
        // Escape cancels; the line edit passes on keys it does not use.
        key-pressed(event) => {
            if (event.text == Key.Escape) {
                root.rename-cancel();
                keys.focus();
                return accept;
            }
            reject
        }
        Rectangle {
            background: #00000080;
        }
        TouchArea { }
        Rectangle {
            width: 340px;
            height: 130px;
            background: #2b2b2b;
            border-radius: 6px;
            border-width: 1px;
            border-color: #555555;
            VerticalBox {
                Text {
                    text: "Rename clip";
                    color: #dddddd;
                    font-weight: 700;
                }
                name := LineEdit {
                    text: root.rename-text;
                    placeholder-text: "Clip name";
                    accepted(text) => {
                        root.rename-done(text);
                        keys.focus();
                    }
                    init => { self.focus(); }
                }
                HorizontalBox {
                    padding: 0;
                    Button {
                        text: "OK";
                        primary: true;
                        clicked => {
                            root.rename-done(name.text);
                            keys.focus();
                        }
                    }
                    Button {
                        text: "Cancel";
                        clicked => {
                            root.rename-cancel();
                            keys.focus();
                        }
                    }
                }
            }
        }
    }
}
